# Host-run backend; use with compose.dev.yml. Generate private values locally.
APP_ENV=development
POSTGRES_DB=sanjeevani_dev
POSTGRES_USER=sanjeevani_dev
POSTGRES_PASSWORD=
# URL-encode the password in this URL. Must match the POSTGRES_* fields above.
DATABASE_URL=postgresql+asyncpg://sanjeevani_dev:REPLACE_WITH_ENCODED_PASSWORD@127.0.0.1:5432/sanjeevani_dev
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=
# Reserved for compatibility; current refresh JWTs use JWT_SECRET.
JWT_REFRESH_SECRET=
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
