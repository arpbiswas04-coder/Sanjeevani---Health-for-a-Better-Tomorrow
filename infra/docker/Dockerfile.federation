FROM python:3.12-slim

ARG MEMBER4_UID=1000
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 FLWR_TELEMETRY_ENABLED=0 OMP_NUM_THREADS=1 HOME=/tmp
WORKDIR /app/infra
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --upgrade pip==26.2.1 setuptools==84.0.0 wheel \
    && python -m pip install --no-cache-dir torch==2.14.0 --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir flwr==1.39.0 protobuf==6.33.5 cryptography==46.0.7 click==8.5.0 \
    && useradd --uid ${MEMBER4_UID} --create-home member4 \
    && mkdir -p /app/infra/federated/checkpoints \
    && chown member4:member4 /app/infra/federated/checkpoints
RUN python -m pip check \
    && python -m pip uninstall -y pip \
    && python -c "import ensurepip,pathlib,shutil; shutil.rmtree(pathlib.Path(ensurepip.__file__).parent / '_bundled')"
COPY federated ./federated
COPY optimization/common ./optimization/common
COPY optimization/__init__.py ./optimization/__init__.py
COPY docker/federation-entrypoint.py ./docker/federation-entrypoint.py
USER member4
ENTRYPOINT ["python", "docker/federation-entrypoint.py"]
CMD ["server"]
