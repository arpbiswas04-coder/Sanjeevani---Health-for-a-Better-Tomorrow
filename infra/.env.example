# Reference only. Use deployment/prepare_local_env.py for fresh local credentials.
# Never overwrite an existing .env or database password.
MEMBER4_DB_PASSWORD=
MEMBER4_JWT_SECRET=
MEMBER4_JWT_REFRESH_SECRET=
MEMBER4_UID=1000
PUBLIC_HTTPS_ORIGIN=https://localhost:9443
CORS_ALLOWED_ORIGINS=["https://localhost:9443"]
NGINX_TLS_DIRECTORY=./federated/secrets/local-dev/ingress
NGINX_CONFIG=./nginx/member4-tls.conf
NGINX_AUTH_RATE=5r/m
NGINX_OPERATIONS_RATE=2r/s
NGINX_API_RATE=20r/s
# Storage CLI reads process environment, not this file automatically.
BACKUP_STORAGE_MODE=local
BACKUP_LOCAL_DIRECTORY=
S3_BUCKET=
S3_ENDPOINT=
# Boto3 supports workload identity or AWS_PROFILE/AWS_REGION/standard credentials.
# Deployment workflow reads GitHub Environment variables and secrets, not this file.
DEPLOY_PROVIDER=ssh-compose
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=
